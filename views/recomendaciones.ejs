<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #0b3d91 0%, #0b3d91 100%); min-height:100vh; padding:20px; }

.container { max-width: 1200px; margin:0 auto; }

header { text-align:center; color:white; margin-bottom:40px; }
header h1 { font-size:2.5rem; margin-bottom:10px; }
header p { font-size:1.1rem; opacity:0.9; }
header a { display:inline-block; margin-top:15px; padding:10px 20px; background:white; color:#0b3d91; text-decoration:none; border-radius:25px; font-weight:bold; transition:all 0.3s; }
header a:hover { transform:translateY(-2px); box-shadow:0 5px 15px rgba(0,0,0,0.2); }

.section { background:white; border-radius:15px; padding:25px; margin-bottom:30px; box-shadow:0 5px 20px rgba(0,0,0,0.1); }

.section h2 { color:#333; font-size:1.8rem; margin-bottom:20px; padding-bottom:10px; border-bottom:3px solid #0b3d91; }

.alert { padding:15px; border-radius:10px; margin-bottom:15px; font-weight:500; }
.alert-warning { background:#fff3cd; border-left:5px solid #ffc107; color:#856404; }
.alert-success { background:#d4edda; border-left:5px solid #28a745; color:#155724; }
.alert-danger { background:#f8d7da; border-left:5px solid #dc3545; color:#721c24; }

.recommendations-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:20px; margin-top:20px; }

.card { background:#f8f9fa; padding:20px; border-radius:10px; border-left:5px solid #667eea; transition:transform 0.3s; }
.card:hover { transform:translateY(-5px); box-shadow:0 5px 15px rgba(0,0,0,0.15); }
.card h3 { color:#667eea; font-size:1.2rem; margin-bottom:10px; }
.card p { color:#666; margin:5px 0; }
.card .badge { display:inline-block; padding:5px 10px; background:#667eea; color:white; border-radius:5px; font-size:0.85rem; margin-top:10px; }

table { width:100%; border-collapse:collapse; margin-top:20px; }
table th, table td { padding:12px; text-align:left; border-bottom:1px solid #ddd; }
table th { background:#667eea; color:white; font-weight:600; }
table tbody tr:hover { background:#f5f5f5; }

.icon { font-size:1.5rem; margin-right:10px; }

@media(max-width:768px) {
  header h1 { font-size:2rem; }
  .recommendations-grid { grid-template-columns:1fr; }
  table { font-size:0.85rem; }
}
</style>
</head>
<body>
<div class="container">
  <header>
    <h1>💡 Recomendaciones Inteligentes</h1>
    <p>Acciones sugeridas para optimizar tu inventario</p>
    <a href="/dashboard">← Volver al Dashboard</a>
  </header>

  <!-- Productos con baja rotación (necesitan descuento) -->
  <section class="section">
    <h2><span class="icon">🔻</span>Productos con Baja Rotación</h2>
    <div class="alert alert-warning">
      ⚠️ Estos productos tienen poca salida. Considera aplicar descuentos o promociones para reducir el inventario.
    </div>
    
    <% if (bajaRotacion.length > 0) { %>
      <div class="recommendations-grid">
        <% bajaRotacion.forEach(p => { %>
          <div class="card">
            <h3><%= p.nombre %></h3>
            <p><strong>Categoría:</strong> <%= p.tipo_ropa %></p>
            <p><strong>Stock actual:</strong> <%= p.stock %> unidades</p>
            <p><strong>Ventas totales:</strong> <%= p.total_ventas %> unidades</p>
            <p><strong>Rotación:</strong> <%= (Number(p.rotacion) || 0).toFixed(2) %>x</p>
            <span class="badge">🏷️ Sugerir descuento 15-30%</span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p style="color:#666; margin-top:10px;">✅ No hay productos con baja rotación en este momento.</p>
    <% } %>
  </section>

  <!-- Productos con alta rotación (necesitan reposición) -->
  <section class="section">
    <h2><span class="icon">🔥</span>Productos con Alta Rotación</h2>
    <div class="alert alert-success">
      ✅ Estos productos se venden rápidamente. Considera aumentar el stock para evitar desabastecimiento.
    </div>
    
    <% if (altaRotacion.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Stock</th>
            <th>Ventas</th>
            <th>Rotación</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          <% altaRotacion.forEach(p => { %>
            <tr>
              <td>#<%= p.id_producto %></td>
              <td><%= p.nombre %></td>
              <td><%= p.tipo_ropa %></td>
              <td><%= p.stock %></td>
              <td><%= p.total_ventas %></td>
              <td><strong><%= (Number(p.rotacion) || 0).toFixed(2) %>x</strong></td>
              <td>📦 <strong>Reponer stock</strong></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p style="color:#666; margin-top:10px;">No hay productos con alta rotación en este momento.</p>
    <% } %>
  </section>

  <!-- Productos con stock crítico -->
  <section class="section">
    <h2><span class="icon">⚠️</span>Productos con Stock Crítico</h2>
    <div class="alert alert-danger">
      🚨 Estos productos tienen stock muy bajo (≤5 unidades). Requieren atención inmediata.
    </div>
    
    <% if (stockCritico.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Stock Actual</th>
            <th>Ventas</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          <% stockCritico.forEach(p => { %>
            <tr style="background:#fff5f5;">
              <td>#<%= p.id_producto %></td>
              <td><strong><%= p.nombre %></strong></td>
              <td><%= p.tipo_ropa %></td>
              <td style="color:#dc3545; font-weight:bold;"><%= p.stock %> unidades</td>
              <td><%= p.total_ventas %></td>
              <td>🚨 <strong>URGENTE: Reponer ahora</strong></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p style="color:#666; margin-top:10px;">✅ No hay productos con stock crítico en este momento.</p>
    <% } %>
  </section>

  <!-- Resumen de acciones -->
  <section class="section">
    <h2><span class="icon">📋</span>Resumen de Acciones</h2>
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:15px; margin-top:20px;">
      <div style="background:#fff3cd; padding:20px; border-radius:10px; text-align:center;">
        <div style="font-size:2rem; color:#856404;">🏷️</div>
        <p style="font-size:2rem; font-weight:bold; color:#856404; margin:10px 0;"><%= bajaRotacion.length %></p>
        <p style="color:#666;">Productos para promocionar</p>
      </div>
      <div style="background:#d4edda; padding:20px; border-radius:10px; text-align:center;">
        <div style="font-size:2rem; color:#155724;">📦</div>
        <p style="font-size:2rem; font-weight:bold; color:#155724; margin:10px 0;"><%= altaRotacion.length %></p>
        <p style="color:#666;">Productos para reponer</p>
      </div>
      <div style="background:#f8d7da; padding:20px; border-radius:10px; text-align:center;">
        <div style="font-size:2rem; color:#721c24;">🚨</div>
        <p style="font-size:2rem; font-weight:bold; color:#721c24; margin:10px 0;"><%= stockCritico.length %></p>
        <p style="color:#666;">Productos críticos</p>
      </div>
    </div>
  </section>
</div>
</body>
</html>