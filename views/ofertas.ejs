    </div>
  </header>

  <!-- MAIN -->
  <main class="container products-section">
    <div class="section-header">
      <h2>Ofertas Especiales</h2>
      <a href="#" class="small-link">Ver todos</a>
    </div>
    <div class="products-grid">
      <article class="product-card">
        <div class="product-media">
          <img src="/imgs/vestido4.jpg" alt="Oferta Mujer" />
          <button class="wishlist-btn">♡</button>
        </div>
        <div class="product-body">
          <h3 class="product-title">Vestido Mujer -20%</h3>
          <p class="product-meta">Tallas: S, M, L</p>
          <div class="product-footer">
            <span class="price">$55.000</span>
            <div class="actions">
              <button class="btn small yellow">Añadir</button>
              <button class="btn small purple-outline">Detalles</button>
            </div>
          </div>
        </div>
      </article>

      <article class="product-card">
        <div class="product-media">
          <img src="/imgs/camiseta4.jpeg" alt="Oferta Hombre" />
          <button class="wishlist-btn">♡</button>
        </div>
        <div class="product-body">
          <h3 class="product-title">Camisa Hombre -30%</h3>
          <p class="product-meta">Tallas: M, L, XL</p>
          <div class="product-footer">
            <span class="price">$70.000</span>
            <div class="actions">
              <button class="btn small yellow">Añadir</button>
              <button class="btn small purple-outline">Detalles</button>
            </div>
          </div>
        </div>
      </article>

      <article class="product-card">
        <div class="product-media">
          <img src="/imgs/pantalon4.jpg" alt="Oferta Niño" />
          <button class="wishlist-btn">♡</button>
        </div>
        <div class="product-body">
          <h3 class="product-title">Pantalón Niño -25%</h3>
          <p class="product-meta">Tallas: 4,6,8,10</p>
          <div class="product-footer">
            <span class="price">$40.000</span>
            <div class="actions">
              <button class="btn small yellow">Añadir</button>
              <button class="btn small purple-outline">Detalles</button>
            </div>
          </div>
        </div>
      </article>
    </div>
  </main>
